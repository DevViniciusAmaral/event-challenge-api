PORT=3000
CORS_ORIGIN=http://localhost:3000

# Organizer ID utilizado enquanto não há autenticação real
# Substitua pelo ID real de um documento na coleção 'organizers' do Firestore
ORGANIZER_ID=default-organizer

# Firebase Admin SDK
# Obtenha as credenciais em: Firebase Console > Configurações do projeto > Contas de serviço
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
